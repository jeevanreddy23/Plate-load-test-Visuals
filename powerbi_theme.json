{
  "name": "STS Engineering Minimal",
  "dataColors": ["#17375E", "#6B7280", "#A23B3B", "#2F6F73", "#B08968", "#93A4B7"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#17375E",
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "fontFace": "Segoe UI", "color": { "solid": { "color": "#111827" } }, "fontSize": 12 }],
        "labels": [{ "fontFace": "Segoe UI", "color": { "solid": { "color": "#374151" } } }],
        "categoryAxis": [{ "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "labelColor": { "solid": { "color": "#4B5563" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E5E7EB" } }, "labelColor": { "solid": { "color": "#4B5563" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#374151" } }, "fontFace": "Segoe UI" }]
      }
    }
  }
}
